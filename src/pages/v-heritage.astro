---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Split from '../components/Split.astro';
import RollLink from '../components/RollLink.astro';
import RollButton from '../components/RollButton.astro';
import IndexRow from '../components/IndexRow.astro';
import Media from '../components/Media.astro';
import coverImage from '../assets/images/cover-v-heritage.jpg';
import { EMAIL, USER_FLOW_URL, UI_DESIGN_URL } from '../data/links';

const base = import.meta.env.BASE_URL;
const home = `${base}/`;

const steps = [
	['01', 'Idea', 'Hình thành ý tưởng và xác định vấn đề cần giải quyết.', 'idea'],
	['02', 'Competitive Analysis', 'Nghiên cứu và phân tích các ứng dụng tương tự trên thị trường.', 'competitive'],
	['03', 'User Research', 'Khảo sát người dùng, tìm hiểu nhu cầu, hành vi và khó khăn.', 'research'],
	['04', 'User Persona', 'Xây dựng chân dung người dùng mục tiêu dựa trên kết quả nghiên cứu.', 'persona'],
	['05', 'User Flow', 'Xây dựng luồng thao tác và các bước người dùng cần thực hiện.', 'user-flow'],
	['06', 'Wireframe', 'Phác thảo cấu trúc, bố cục và chức năng của từng màn hình.', 'user-flow'],
	['07', 'Design System', 'Thư viện thiết kế gồm màu sắc, kiểu chữ, hiệu ứng.', 'design-system'],
	['08', 'UI Design', 'Thiết kế giao diện và các thành phần UI.', 'user-flow'],
	['09', 'Prototype', 'Kết nối màn hình, mô phỏng trải nghiệm thực tế.', 'user-flow'],
];

const highlights = [
	'Ứng dụng tham quan bảo tàng và di tích lịch sử tích hợp công nghệ AR.',
	'Cho phép tương tác với mô hình 3D, khám phá chi tiết và tìm hiểu giá trị của hiện vật.',
	'Cung cấp Audio Guide, lưu hiện vật yêu thích và chia sẻ trải nghiệm tham quan.',
	'Hỗ trợ các đơn vị quản lý số hóa hiện vật và tối ưu hóa trải nghiệm du khách.',
];

const ideaPoints = [
	'Xuất phát từ trải nghiệm thực tế khi tham quan bảo tàng, nơi việc tìm hiểu sâu về các hiện vật còn gặp nhiều hạn chế.',
	'Khách tham quan thường phải tập trung đọc thông tin trên các biển thuyết minh, đặc biệt bất tiện khi không gian đông đúc.',
	'Mong muốn tạo ra một phương thức khám phá hiện vật trực quan, sinh động và thuận tiện hơn.',
	'Ứng dụng công nghệ AR mang đến trải nghiệm tương tác, giúp người dùng tiếp cận gần hơn với giá trị văn hóa và lịch sử.',
];

const segments = [
	{
		kicker: '12 – 30 tuổi',
		name: 'Gen Z',
		desc: 'Dễ chán vì nội dung lặp lại, mô tả dài, khô khan. Vẫn muốn hiểu câu chuyện sau hiện vật, sẵn sàng thử AR và thích chia sẻ.',
		insight: 'Tối giản, nội dung ngắn gọn, mô hình 3D và camera AR.',
	},
	{
		kicker: 'Tự tham quan',
		name: 'Khách du lịch',
		desc: 'Dễ bỏ qua hiện vật vì thiếu bối cảnh. Hứng thú với AR phục dựng nhưng lo về độ chính xác.',
		insight: '"Quét là biết" với AR được bảo tàng xác minh, audio guide đa ngôn ngữ.',
	},
	{
		kicker: 'Trên 45 tuổi',
		name: 'Người lớn tuổi',
		desc: 'Khó đọc chữ nhỏ khi thiếu sáng, dễ mệt khi đứng lâu, ngại ứng dụng phức tạp. Muốn nghe thuyết minh và dùng giọng nói.',
		insight: 'Chữ lớn, tương phản cao, nút rõ ràng, audio "có hồn" và trợ lý ảo.',
	},
];

const stats = [
	['42,9%', 'Gamification'],
	['39,8%', 'Audio storytelling'],
	['58,2%', 'Cần chế độ offline'],
	['46,9%', 'Không muốn quảng cáo làm phiền'],
	['41,8%', 'Cập nhật nội dung mới'],
];

const personaBlocks = [
	{
		title: 'Mục tiêu & mong muốn',
		items: [
			'Thông tin đúng và đủ hơn giao diện bóng bẩy',
			'Hiểu câu chuyện và ý nghĩa của hiện vật',
			'Quét nhanh để ra thông tin ngay',
			'Giá dễ tiếp cận, có bản miễn phí',
		],
	},
	{
		title: 'Pain points',
		items: [
			'Phải rời mắt khỏi hiện vật để tra Google',
			'Bỏ qua hiện vật vì không hiểu',
			'Rào cản ngôn ngữ khi tham quan',
			'Lo phục dựng AR không chính xác',
		],
	},
	{
		title: 'Hành vi',
		items: [
			'Tìm hiểu qua Google và MXH trước chuyến đi',
			'Chưa dùng app hỗ trợ tham quan',
			'Sẵn sàng dùng app thuyết minh xuyên suốt',
			'Ưu tiên nội dung hơn tính năng',
		],
	},
];

// Màu của chính app V-Heritage (nội dung minh hoạ), không phải token của portfolio
const swatches = [
	{ name: 'Navy', hex: '#304574', role: 'Chủ đạo', fg: 'var(--color-v2-on-dark)' },
	{ name: 'Cam', hex: '#ED8927', role: 'Điểm nhấn', fg: 'var(--color-v2-ink-darkest)' },
	{ name: 'Trắng', hex: '#FFFFFF', role: 'Nền', fg: 'var(--color-v2-ink)', border: true },
	{ name: 'Xanh sáng', hex: '#5F8AEC', role: 'Công nghệ · AR', fg: 'var(--color-v2-ink-darkest)' },
	{ name: 'Be', hex: '#EFDEC4', role: 'Giấy cổ · di sản', fg: 'var(--color-v2-ink)', border: true },
];

const gridSpecs = [
	['4', 'cột'],
	['20px', 'lề'],
	['4px', 'lưới dòng'],
	['44px', 'header'],
	['34px', 'footer'],
];
---

<Base
	title="V-Heritage — Case study | Thanh Tuyền"
	description="V-Heritage: ứng dụng tham quan bảo tàng và di tích lịch sử tích hợp công nghệ AR. Case study UX/UI của Thanh Tuyền."
>
	<header class="cs-header-bar">
		<div class="wrap cs-header" data-reveal="down" data-delay="0">
			<RollLink href={home} label="← Trang chủ" class="back" />
			<a class="logo" href={home}>
				<span class="logo-kicker">PORTFOLIO</span>
				<span class="logo-name">THANH TUYỀN</span>
			</a>
		</div>
	</header>

	<main>
		<section class="cs-hero">
			<div class="wrap">
				<div class="hero-meta" data-reveal="meta" data-delay="0.1">
					<span>Study Project</span>
					<span>07/2026 - 10/2026</span>
				</div>
				<Split as="h1" mode="char" class="cs-title" delay={0.2}>
					V-Heritage<span class="serif-italic">.</span>
				</Split>
				<Split class="cs-subtitle" delay={0.8}>
					Ứng dụng tham quan bảo tàng và di tích lịch sử tích hợp công nghệ AR.
				</Split>
				<dl class="cs-meta">
					<div data-reveal="meta" data-delay="1.1">
						<dt>Nền tảng</dt>
						<dd>Mobile App · iOS/ Android</dd>
					</div>
					<div data-reveal="meta" data-delay="1.18">
						<dt>Công nghệ</dt>
						<dd>AR · 3D · Audio Guide</dd>
					</div>
					<div data-reveal="meta" data-delay="1.26">
						<dt>Công cụ</dt>
						<dd>Figma</dd>
					</div>
				</dl>
				<div class="cover" data-reveal="media" data-delay="1.3">
					<Picture
						src={coverImage}
						alt="Ứng dụng V-Heritage trên điện thoại, đặt trên nền xanh"
						widths={[800, 1400, 2000]}
						sizes="(max-width: 1440px) 100vw, 1344px"
						formats={['avif', 'webp']}
						loading="eager"
					/>
				</div>
			</div>
		</section>

		<section class="section overview">
			<div class="wrap split">
				<div class="aside">
					<h2 class="aside-label" data-reveal="label">
						Tổng quan
					</h2>
				</div>
				<div class="main stack-40">
					<Split class="statement">
						Biến mỗi hiện vật thành một câu chuyện có thể{' '}
						<span class="serif-italic accent-serif">chạm, xoay và lắng nghe.</span>
					</Split>
					<ol class="highlights">
						{highlights.map((text, i) => (
							<li class="highlight" data-reveal>
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<span>{text}</span>
							</li>
						))}
					</ol>
				</div>
			</div>
		</section>

		<section class="section process on-dark">
			<div class="wrap split">
				<div class="aside">
					<h2 class="aside-label" data-reveal="label">
						Quy trình
					</h2>
				</div>
				<div class="main">
					{steps.map(([no, title, desc, target]) => (
						<IndexRow no={no} title={title} desc={desc} href={`#${target}`} tone="dark" />
					))}
				</div>
			</div>
		</section>

		<section class="section idea" id="idea">
			<div class="wrap split">
				<div class="aside">
					<h2 class="aside-label" data-reveal="label">
						01 | Ý tưởng
					</h2>
					<Media label="Màn hình quét hiện vật" class="idea-media" data-reveal="media" />
				</div>
				<div class="main stack-40">
					<Split class="idea-statement">
						Khách tham quan phải <span class="serif-italic accent-serif">rời mắt khỏi hiện vật</span> để đọc biển thuyết
						minh,
						<br />
						nhất là khi bảo tàng đông người.
					</Split>
					<ol class="points" data-reveal>
						{ideaPoints.map((text, i) => (
							<li>
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<span>{text}</span>
							</li>
						))}
					</ol>
				</div>
			</div>
		</section>

		<section class="section competitive on-dark" id="competitive">
			<div class="wrap split">
				<div class="aside">
					<h2 class="aside-label" data-reveal="label">
						02 | Phân tích thị trường
					</h2>
				</div>
				<div class="main stack-40">
					<p class="body-l" data-reveal="label">
						Thị trường du lịch Việt Nam đang tăng trưởng mạnh sau đại dịch, kéo theo làn sóng du lịch thông minh với AI
						và AR/VR. Dù vậy, phần lớn ứng dụng hiện nay mới chỉ dừng ở khâu đặt vé, tra cứu hay gợi ý điểm đến, nhưng
						câu chuyện trải nghiệm ngay tại điểm tham quan vẫn là một khoảng trống.
					</p>
					<div class="ca-cards">
						<div class="ca-card ca-card--solution" data-reveal>
							<p class="ca-label">Giải pháp</p>
							<p class="ca-text">
								AR kết hợp storytelling: du khách có hành trình sinh động, giàu tương tác; bảo tàng thấu hiểu khách qua
								dữ liệu hành vi và dễ vận hành nội dung.
							</p>
						</div>
						<div class="ca-card ca-card--challenge" data-reveal>
							<p class="ca-label">Thách thức</p>
							<p class="ca-text">
								Quy trình phê duyệt kéo dài
								<br />
								Chi phí số hóa 3D cao
								<br />
								Tính năng AR phải ổn định trên nhiều dòng máy.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section qual" id="research">
			<div class="wrap split">
				<div class="aside">
					<h2 class="aside-label" data-reveal="label">
						03 | Nghiên cứu định tính
					</h2>
				</div>
				<div class="main segments">
					{segments.map((s) => (
						<div class="segment" data-reveal>
							<div class="segment-head">
								<p class="segment-kicker">{s.kicker}</p>
								<h3 class="segment-name">{s.name}</h3>
							</div>
							<p class="segment-desc">{s.desc}</p>
							<div class="insight">
								<p class="insight-label">Hướng giải quyết</p>
								<p>{s.insight}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="section quant on-dark" id="research-quant">
			<div class="wrap split">
				<div class="aside">
					<h2 class="aside-label" data-reveal="label">
						03 | Nghiên cứu định lượng
					</h2>
				</div>
				<div class="main stack-40">
					<div class="hero-stat">
						<Split mode="char" class="big-number">
							77,6%
						</Split>
						<p class="hero-stat-caption" data-reveal="label">
							chọn AR 3D là tính năng mong đợi nhất:{' '}
							<strong>
								<em>xoay, phóng to và khám phá chi tiết ẩn của hiện vật.</em>
							</strong>
						</p>
					</div>
					<ul class="stats">
						{stats.map(([value, label]) => (
							<li class="stat" data-reveal>
								<span class="stat-value">{value}</span>
								<span class="stat-label">{label}</span>
							</li>
						))}
					</ul>
					<p class="takeaway" data-reveal="label">
						→ AR 3D là tính năng cốt lõi, kết hợp audio kể chuyện và gamification để giữ chân người dùng.
					</p>
				</div>
			</div>
		</section>

		<section class="section persona" id="persona">
			<div class="wrap">
				<div class="split">
					<div class="aside">
						<h2 class="aside-label" data-reveal="label">
							04 | User Persona
							<br />
							(Chân dung người dùng)
						</h2>
					</div>
					<div class="main persona-main">
						<div class="identity" data-reveal>
							<Media label="Avatar" class="avatar" />
							<div>
								<h3 class="persona-name">Đỗ Đức Mạnh</h3>
								<p class="persona-meta">29 tuổi · Hà Nội · Nhân viên văn phòng</p>
							</div>
						</div>
						<Split as="blockquote" class="quote">
							“Chuyến tham quan chỉ có giá trị khi hiểu được câu chuyện đằng sau chứ không chỉ nhìn ngắm bề ngoài.”
						</Split>
					</div>
				</div>
				<div class="persona-grid">
					{personaBlocks.map((block) => (
						<div class="persona-block" data-reveal>
							<h3 class="persona-block-title">{block.title}</h3>
							<ul>
								{block.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="section ds" id="design-system">
			<div class="wrap split">
				<div class="aside">
					<h2 class="aside-label" data-reveal="label">
						07 | Design System
					</h2>
				</div>
				<div class="main stack-40">
					<ul class="swatches">
						{swatches.map((s) => (
							<li
								class:list={['swatch', { 'swatch--border': s.border }]}
								style={`background:${s.hex};color:${s.fg}`}
								data-reveal
							>
								<span class="swatch-name">{s.name}</span>
								<span class="swatch-hex">{s.hex}</span>
								<span class="swatch-role">{s.role}</span>
							</li>
						))}
					</ul>
					<p class="body-l" data-reveal="label">
						Màu Navy #304574 gợi sự tin cậy, trầm tĩnh, trang nghiêm; cam #ED8927 thu hút vào hành động chính. Chữ trắng
						trên nền navy đạt chuẩn WCAG AAA dễ đọc cho người lớn tuổi và trong điều kiện ánh sáng yếu của bảo tàng.
					</p>
					<div class="fonts">
						<div class="font-card" data-reveal>
							<p class="font-role">Display · Heading</p>
							<p class="font-sample literata" aria-hidden="true">
								Aa
							</p>
							<p class="font-name literata">Literata</p>
							<p class="font-desc">
								Phông có chân, từ “literatus” nghĩa là người uyên bác. Cổ điển như trang sách lịch sử.
							</p>
						</div>
						<div class="font-card" data-reveal>
							<p class="font-role">Title · Body · Button · Label</p>
							<p class="font-sample bvp" aria-hidden="true">
								Aa
							</p>
							<p class="font-name bvp">Be Vietnam Pro</p>
							<p class="font-desc">Thiết kế riêng cho tiếng Việt với dấu chuẩn xác, dễ đọc ở cỡ lớn.</p>
						</div>
					</div>
					<ul class="specs">
						{gridSpecs.map(([value, label]) => (
							<li class="spec" data-reveal>
								<span class="spec-value">{value}</span>
								<span class="spec-label">{label}</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>

		<section class="section user-flow" id="user-flow">
			<div class="wrap">
				<div class="split">
					<div class="aside">
						<h2 class="aside-label" data-reveal="label">
							05 · 08 · 09 |<br />
							User Flow · UI Design · Prototype
						</h2>
					</div>
					<div class="main stack-40">
						<p class="body-l" data-reveal="label">
							Hành trình B2C bắt đầu từ onboarding: hệ thống tự gợi ý chế độ trợ năng cho người trên 45 tuổi và đề xuất
							tải gói dữ liệu khi phát hiện người dùng đang ở bảo tàng. Tại hiện vật, AI nhận diện và hiển thị mô hình
							AR 3D, audio guide, chụp ảnh, lưu trữ và để lại lời nhắn. Khi quét thất bại: quét QR, tìm theo tên hoặc
							xem ngoại tuyến.
						</p>
						<div class="cta-row">
							<div data-reveal>
								<RollButton href={USER_FLOW_URL} label="Xem User Flow" variant="dark" external />
							</div>
							<div data-reveal>
								<RollButton href={UI_DESIGN_URL} label="Xem UI Design" variant="light" external />
							</div>
						</div>
					</div>
				</div>
				<div class="ui-shots">
					<Media label="Màn hình Onboarding" class="ui-shot" data-reveal="media" />
					<Media label="Màn hình quét AR" class="ui-shot" data-reveal="media" />
					<Media label="Màn hình Audio Guide" class="ui-shot" data-reveal="media" />
				</div>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="wrap footer-inner">
			<div class="footer-main">
				<Split class="footer-statement">Quay lại trang chủ?</Split>
				<div class="footer-ctas">
					<div data-reveal>
						<RollLink href={`mailto:${EMAIL}`} label={EMAIL} theme="dark" />
					</div>
					<div data-reveal>
						<RollButton href={home} label="Về trang chủ" variant="accent" />
					</div>
				</div>
			</div>
			<p class="copyright" data-reveal>
				© 2026 Rin
			</p>
		</div>
		<Split as="p" mode="char" class="giant" aria-hidden="true">
			PORTFOLIO
		</Split>
	</footer>
</Base>

<style>
	.on-dark {
		background: var(--color-v2-accent-deep);
		color: var(--color-v2-on-dark);
	}

	.stack-40 {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.num {
		flex: none;
		font-size: 14px;
		line-height: 24px;
